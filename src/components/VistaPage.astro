---
import raw from '../../.data/property.json';
import { Image } from 'astro:assets';
import { localImage } from '../config/images';
import VistaUnit from './VistaUnit.astro';
import '../styles/vista-units.css';
import '../styles/vista.css';
interface Props { locale: 'en' | 'sl' }
const {locale}=Astro.props;
const sl=locale==='sl';
const t=(en:string,si:string)=>sl?si:en;
const units=raw.units;
const url='https://www.bledapartmaji.si/';
---
<!doctype html>
<html lang={locale}>
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Bled Apartmaji</title>
<meta name="description" content={t('Discover Bled Vista apartments and Sova accommodation in Bled, Slovenia. Explore rooms, mountain views and terraces. Contact your hosts directly.','Odkrijte apartmaje Bled Vista in nastanitve Sova na Bledu. Oglejte si sobe, razglede in terase ter stopite v stik z gostitelji.')}/>
<link rel="canonical" href={url+(sl?'sl/':'')}/><link rel="alternate" hreflang="en" href={url}/><link rel="alternate" hreflang="sl" href={url+'sl/'}/>
<meta property="og:title" content="Bled Apartmaji"/><meta property="og:description" content={t('Your own little corner of Bled.','Vaš mali kotiček Bleda.')}/><meta property="og:image" content={url+'images/bled/header.jpg'}/>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 80'%3E%3Crect width='80' height='80' rx='40' fill='%23283f35'/%3E%3Cpath d='M12 54 32 24 45 44 54 32 70 54' fill='none' stroke='%23f7f5ef' stroke-width='3'/%3E%3C/svg%3E"/>
</head>
<body>
<a class="skip" href="#main">{t('Skip to content','Preskoči na vsebino')}</a>
<header class="header wrap">
<a class="brand" href={sl?'/sl/':'/'}>Bled Apartmaji</a>
<nav class="desktop-nav" aria-label={t('Main navigation','Glavna navigacija')}><a href="#stay">{t('Your stay','Nastanitve')}</a><a href="#contact">{t('Contact','Kontakt')}</a></nav>
<div class="header-end"><a class="language" href={sl?'/':'/sl/'} lang={sl?'en':'sl'}>{sl?'EN':'SL'} <span>↗</span></a><details class="mobile-menu"><summary aria-label={t('Navigation menu','Navigacijski meni')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></summary><nav aria-label={t('Mobile navigation','Mobilna navigacija')}><a href="#stay">{t('Your stay','Nastanitve')}</a><a href="#contact">{t('Contact','Kontakt')}</a></nav></details></div>
</header>
<script>
const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu');
if(menu){
 const close=()=>{menu.open=false;};
 menu.querySelectorAll('a').forEach(link=>link.addEventListener('click',close));
 document.addEventListener('click',event=>{if(event.target instanceof Node&&!menu.contains(event.target))close();});
 document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menu.open){close();menu.querySelector('summary')?.focus();}});
 window.matchMedia('(min-width: 601px)').addEventListener('change',event=>{if(event.matches)close();});
}
</script>
<main id="main">
<section class="hero">
<Image src={localImage('/images/bled/header.jpg')} widths={[640,960,1440,1920]} sizes="100vw" format="webp" loading="eager" alt={t('Bled island and its church in the soft light of sunset','Blejski otok in cerkev v nežni svetlobi sončnega zahoda')} fetchpriority="high"/>
<div class="hero-content wrap"><p class="eyebrow">BLED, SLOVENIA · {t('A PLACE TO SLOW DOWN','ČAS ZA SPROSTITEV')}</p><h1>{t('Your own little','Vaš mali')}<br/><em>{t('corner of Bled.','kotiček Bleda.')}</em></h1><p>{t('Two locations. Seven unique stays. Your Bled escape starts here.','Dve lokaciji. Sedem edinstvenih nastanitev. Vaš oddih na Bledu se začne tukaj.')}</p><a class="button cream" href="#stay">{t('Explore our stays','Raziščite nastanitve')} <span>↗</span></a></div>
<div class="hero-foot wrap"><span>{t('APARTMENTS & ROOMS','APARTMAJI IN SOBE')}</span><a href="#welcome">{t('A warm welcome awaits','Dobrodošli pri nas')} ↓</a></div>
</section>
<section id="welcome" class="intro wrap section"><div><p class="eyebrow">BLED APARTMAJI</p><h2>{t('Away from the everyday.','Daleč od vsakdana.')}<br/><em>{t('Right at home.','Kot doma.')}</em></h2></div><div class="intro-copy"><p>{t('Welcome to Bled Apartmaji, a delightful collection of seven comfortable apartments, each offering breathtaking views of the surrounding mountains. The apartments provide the perfect blend of privacy and homeliness, all while being close to the main attractions of Bled.','Dobrodošli v Bled Apartmaji, očarljivi zbirki sedmih udobnih apartmajev, od katerih vsak ponuja dih jemajoč razgled na okoliške gore. Apartmaji združujejo zasebnost in domačnost, hkrati pa so blizu glavnih znamenitosti Bleda.')}</p></div></section>
<div class="comforts wrap"><span><svg class="comfort-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M10 17V7h3a3 3 0 0 1 0 6h-3"/></svg><b>{t('Free parking','Brezplačno parkiranje')}</b></span><span><svg class="comfort-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 8a16 16 0 0 1 20 0M5 12a11 11 0 0 1 14 0M8.5 16a5.5 5.5 0 0 1 7 0"/><circle cx="12" cy="20" r="1"/></svg><b>{t('Free Wi-Fi','Brezplačen Wi-Fi')}</b></span><span><svg class="comfort-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M3.34 7l17.32 10M3.34 17 20.66 7M9 4l3 3 3-3M9 20l3-3 3 3M4 10l4-1-1-4M17 19l-1-4 4-1M4 14l4 1-1 4M17 5l-1 4 4 1"/></svg><b>{t('Air conditioning','Klimatska naprava')}</b></span><span><svg class="comfort-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7H3ZM12 10v11M8 21h8M3 14v7M3 17h5v4M21 14v7M21 17h-5v4"/></svg><b>{t('Shared terrace','Skupna terasa')}</b></span></div>
<section id="stay" class="section wrap"><div class="section-heading"><div><p class="eyebrow">{t('MAKE YOURSELF AT HOME','POČUTITE SE KOT DOMA')}</p></div></div>
<div class="collection-title"><h3>Bled Vista <em>Apartments</em></h3><span>Finžgarjeva cesta 23A · 4260 Bled</span></div>
<nav class="unit-jump-links" aria-label={t('Choose a unit','Izberite enoto')}>{units.slice(0,5).map(u=><a href={'#'+u.id}>{(sl?u.name:u.name.replace('Apartma','Apartment').replace('soba','room').replace('Soba','Room')).replace(/ \(.*\)/,'')}</a>)}</nav>
<div class="stay-collection">{units.slice(0,5).map((unit,index)=><VistaUnit unit={unit} locale={locale} index={index}/>)}</div>
<div class="collection-title sova-title"><div><p class="eyebrow">{t('OUR SECOND PROPERTY','NAŠA DRUGA NASTANITEV')}</p><h3>{t('Apartment Sova','Apartma Sova')}</h3></div><span>Ljubljanska cesta 33 · Bled</span></div>
<nav class="unit-jump-links" aria-label={t('Choose a unit at Sova','Izberite enoto v nastanitvi Sova')}>{units.slice(5).map(u=><a href={'#'+u.id}>{sl?u.name:u.name.replace('Apartma','Apartment').replace('soba','room').replace('Soba','Room')}</a>)}</nav>
<div class="stay-collection">{units.slice(5).map((unit,index)=><VistaUnit unit={unit} locale={locale} index={index+5}/>)}</div>
</section>
<section id="bled" class="destination"><div class="destination-image"><Image src={localImage('/images/bled/property-0.jpg')} widths={[480,800,1200]} sizes="(max-width: 600px) 100vw, 50vw" format="webp" alt={t('A shaded terrace at Bled Vista Apartments','Senčna terasa pri Bled Vista Apartments')} loading="lazy"/></div><div class="destination-copy"><p class="eyebrow">{t('LESS HURRY. MORE BLED.','MANJ HITENJA. VEČ BLEDA.')}</p><h2>{t('Fresh air.','Svež zrak.')}<br/>{t('A new perspective.','Novi razgledi.')}<br/><em>{t('Simple pleasures.','Preprosti užitki.')}</em></h2><p>{t('A walk by the lake. A day among the mountains. Or just a quiet moment on the terrace. Bled is a place to enjoy at your own pace, in every season.','Sprehod ob jezeru. Dan med gorami. Ali le miren trenutek na terasi. Bled je kraj, ki ga lahko uživate v svojem ritmu, v vsakem letnem času.')}</p><a class="text-link" href="https://www.bled.si/en/" target="_blank" rel="noopener">{t('Discover the destination','Odkrijte destinacijo')} ↗</a></div></section>
<section id="contact" class="section wrap contact" aria-labelledby="contact-title"><div class="contact-intro"><p class="eyebrow">{t('LET’S PLAN YOUR ESCAPE','NAČRTUJMO VAŠ ODDIH')}</p><h2 id="contact-title">{t('A lovely stay starts','Prijeten oddih se začne')}<br/><em>{t('with a hello.','s pozdravom.')}</em></h2><p>{t('Have a question about our apartments or rooms? Get in touch directly — we’ll help you find the right space.','Imate vprašanje o naših apartmajih ali sobah? Stopite v stik z nami – pomagali vam bomo najti pravo nastanitev.')}</p><div class="contact-methods"><a href="mailto:apartma.sova@gmail.com"><span>{t('Email us','Pišite nam')}</span>apartma.sova@gmail.com ↗</a><a href="tel:+38631759164"><span>{t('Call us','Pokličite nas')}</span>+386 31 759 164 ↗</a></div></div><div class="contact-locations"><p class="eyebrow">{t('TWO LOCATIONS IN BLED','DVE LOKACIJI NA BLEDU')}</p><div class="contact-location"><h3>Bled Vista Apartments</h3><address>Finžgarjeva cesta 23A<br/>4260 Bled, {t('Slovenia','Slovenija')}</address><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Fin%C5%BEgarjeva+cesta+23A%2C+4260+Bled" target="_blank" rel="noopener">{t('Directions to Bled Vista','Pot do Bled Vista')} ↗</a><iframe class="contact-map" title={t('Map: Bled Vista Apartments','Zemljevid: Bled Vista Apartments')} src="https://maps.google.com/maps?q=Fin%C5%BEgarjeva%20cesta%2023A%2C%204260%20Bled&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div><div class="contact-location"><h3>{t('Apartment Sova','Apartma Sova')}</h3><address>Ljubljanska cesta 33<br/>Bled, {t('Slovenia','Slovenija')}</address><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Ljubljanska+cesta+33%2C+Bled" target="_blank" rel="noopener">{t('Directions to Apartment Sova','Pot do Apartmaja Sova')} ↗</a><iframe class="contact-map" title={t('Map: Apartment Sova','Zemljevid: Apartma Sova')} src="https://maps.google.com/maps?q=Ljubljanska%20cesta%2033%2C%20Bled&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div></div></section>
</main>
<footer class="wrap"><a class="brand" href="#">Bled Apartmaji</a><p>{t('A little closer to nature. A little closer to yourself.','Bližje naravi. Bližje sebi.')}</p><span>© {new Date().getFullYear()} Bled Apartmaji</span></footer>
</body>
</html>
